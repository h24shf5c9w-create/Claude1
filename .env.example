# =============================================================================
#  ROYAL SPIN — optional configuration
#
#  You do NOT need this file. Without it the game runs on a SQLite file in
#  storage/ and configures itself on the first request. Copy it to `.env` only
#  if you want to change something below.
# =============================================================================

# --- application -----------------------------------------------------------
APP_ENV=production          # local | production   (local enables the balance overlay)
APP_DEBUG=false
APP_TIMEZONE=UTC

# Generated automatically into storage/app.key. Only set this to pin it.
# APP_KEY=

# URL prefix, if the auto-detection ever gets it wrong (e.g. /RoyalSpin/public).
# APP_BASE_PATH=

# Clean URLs need mod_rewrite. The app proves whether it works and picks the
# right form by itself; set this only to force one.
# APP_PRETTY_URLS=true

# Where the database file, session files and the app key live.
# APP_STORAGE=/absolute/path/to/storage

# --- database --------------------------------------------------------------
# sqlite (default, zero setup) or mysql
DB_DRIVER=sqlite

# For DB_DRIVER=mysql:
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=royal_spin
# DB_USERNAME=royal_spin
# DB_PASSWORD=

# --- realtime service (optional) -------------------------------------------
# The game is fully playable without it, using HTTP polling. Run
# `php bin/ws-server.php` only if your host allows long-running processes.
WS_HOST=0.0.0.0
WS_PORT=8081

# Public URL the browser should connect to. Setting this switches clients to
# WebSockets. Behind TLS use wss://your.domain/ws
WS_PUBLIC_URL=

# Force the transport instead of letting the server decide.
# WS_ENABLED=false

# --- session / proxy -------------------------------------------------------
SESSION_NAME=royal_spin_session
SESSION_SECURE=false        # set true when serving over HTTPS
TRUST_PROXY=false           # true only behind a proxy you control
