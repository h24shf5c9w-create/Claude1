# ---------------------------------------------------------------------------
# ROYAL SPIN — copy to .env and adjust.
# ---------------------------------------------------------------------------

APP_ENV=production          # local | production   (local enables the balance overlay)
APP_DEBUG=false
APP_TIMEZONE=UTC
# Used to salt the session fingerprint. Generate one:  openssl rand -hex 32
APP_KEY=change-me-to-a-long-random-string

# --- database --------------------------------------------------------------
# mysql (production) or sqlite (zero-setup local / test runs)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=royal_spin
DB_USERNAME=royal_spin
DB_PASSWORD=

# For DB_DRIVER=sqlite set DB_DATABASE to a file path instead, e.g.
# DB_DRIVER=sqlite
# DB_DATABASE=/var/www/royal-spin/database/royal_spin.sqlite

# --- realtime service ------------------------------------------------------
# Interface/port the `php bin/ws-server.php` process binds to.
WS_HOST=0.0.0.0
WS_PORT=8081
# Public URL the browser should connect to. Leave empty to derive it from the
# page origin (ws://<host>:8081). Behind TLS use wss://your.domain/ws
WS_PUBLIC_URL=

# --- session / proxy -------------------------------------------------------
SESSION_NAME=royal_spin_session
SESSION_SECURE=false        # set true when serving over HTTPS
TRUST_PROXY=false           # true only behind a proxy you control (enables X-Forwarded-For)
